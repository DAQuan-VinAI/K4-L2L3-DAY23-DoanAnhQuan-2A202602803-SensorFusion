# Biến môi trường cho Lab Day 23. Lab KHÔNG cần API key hay token.
#
# Dùng:  cp .env.example .env   rồi   set -a; source .env; set +a
# Chạy mọi lệnh từ gốc repo. File .env không được commit.

# Đường dẫn repo: platform tự suy ra đúng, thường KHÔNG cần đặt. Nếu đặt, dùng
# đường dẫn TUYỆT ĐỐI — đường dẫn tương đối sẽ sai khi chạy lệnh từ thư mục con.
# Thư mục chứa workspace/ của bạn (mặc định: student/ cạnh platform/).
# DAY23_STUDENT_ROOT=/duong/dan/toi/repo/student
# Thư mục platform/ (mặc định: tự suy ra từ package fusion_lab đã cài).
# FUSION_LAB_PLATFORM=/duong/dan/toi/repo/platform

# Trực quan hoá: local (mở cửa sổ) hoặc headless (không mở cửa sổ, dùng trên server/Docker).
DAY23_VIZ_MODE=local
# Đặt 1 để ép chế độ headless.
DAY23_HEADLESS=0
# Thư mục lưu ảnh khi trực quan hoá (bỏ trống = không lưu). Ví dụ: ./student/artifacts
DAY23_VIZ_SAVE_DIR=

# Thư mục cache của matplotlib, tránh lỗi quyền ghi trên một số máy.
MPLCONFIGDIR=/tmp/matplotlib
